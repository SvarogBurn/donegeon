generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Calendar days (startDate, deadlineDate, completedOn, todaySince, ...)
// are stored as "YYYY-MM-DD" strings in the user's local time. They are days,
// not instants, so keeping them out of timestamp columns avoids timezone
// shifts between the phone, the server and the database.

enum DeadlineType {
  hard
  soft
}

enum PointTransactionType {
  earned
  redeemed
  reversal
}

// A task list adds points when an item is ticked; a reward list subtracts them.
enum ListKind {
  task
  reward
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  goals             Goal[]
  tags              Tag[]
  tasks             Task[]
  lists             List[]
  pointTransactions PointTransaction[]
  taskCompletions   TaskCompletion[]
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

// A free-form label. Works like a goal (many per task, filterable) without
// meaning "something I'm working towards".
model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Task {
  id           String        @id @default(uuid())
  userId       String
  parentId     String?
  // The list (folder) a top-level task sits in. Null for subtasks, which
  // belong to their parent's list.
  listId       String?
  title        String
  notes        String?
  startDate    String?
  deadlineDate String?
  deadlineType DeadlineType?
  isComplete   Boolean       @default(false)
  // Stamp-once: set on completion, cleared on un-toggle.
  completedAt  DateTime?
  completedOn  String?
  // Top-level tasks only. Null = worth the list's defaultPoints; a number is a
  // hand-set amount that travels with the task. The list's kind decides add or subtract.
  points       Int?
  // The day the task was marked for Today; null = not in Today.
  todaySince   String?
  // Top-level tasks only. Done again and again: never complete, each press is a TaskCompletion.
  isPersistent Boolean       @default(false)
  // Soft delete, so a delete can be undone. Set on the whole deleted subtree
  // with one shared timestamp; every query must filter on deletedAt = null.
  deletedAt    DateTime?
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent            Task?              @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Task[]             @relation("TaskTree")
  // Any task can carry several goals and several tags.
  goals             Goal[]
  tags              Tag[]
  list              List?              @relation(fields: [listId], references: [id], onDelete: Cascade)
  completions       TaskCompletion[]
  pointTransactions PointTransaction[]

  @@index([userId])
  @@index([parentId])
  @@index([listId])
}

model List {
  id            String    @id @default(uuid())
  userId        String
  name          String
  description   String?
  position      Int       @default(0)
  kind          ListKind  @default(task)
  // What a top-level task in this list is worth unless it has its own amount.
  defaultPoints Int       @default(1)
  isArchived    Boolean   @default(false)
  // Soft delete, undoable like tasks. The list's tasks get the same timestamp.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

// Append-only ledger. Balance = SUM(amount).
model PointTransaction {
  id            String               @id @default(uuid())
  userId        String
  type          PointTransactionType
  amount        Int
  relatedTaskId String?
  // The task's title when the row was written, so history still reads after the task is gone.
  title         String               @default("")
  // On a reversal: the earned / redeemed row it cancels.
  reversesId    String?              @unique
  createdAt     DateTime             @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task?             @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  reverses   PointTransaction? @relation("Reversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy PointTransaction? @relation("Reversal")

  @@index([userId])
  @@index([relatedTaskId])
}

// One press of a persistent task's "done it" button.
model TaskCompletion {
  id                 String   @id @default(uuid())
  userId             String
  taskId             String
  day                String
  // The points this press booked, if any; reversed when the press is undone.
  pointTransactionId String?
  // Subtasks the press unticked for the next round, with their stamps, so undo can put them back.
  unticked           Json     @default("[]")
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Session store for connect-pg-simple. Declared here so Prisma migrations own
// the table and don't report it as drift.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
