generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Calendar days (startDate, deadlineDate, completedOn, todaySince, ...)
// are stored as "YYYY-MM-DD" strings in the user's local time. They are days,
// not instants, so keeping them out of timestamp columns avoids timezone
// shifts between the phone, the server and the database.

enum DeadlineType {
  hard
  soft
}

enum PointTransactionType {
  earned
  redeemed
  reversal
}

// What a repeating task's interval is counted in.
enum RepeatUnit {
  day
  week
  month
}

// A task list adds points when an item is ticked; a reward list subtracts them.
enum ListKind {
  task
  reward
}

// Where a ticked task goes in its list: under the open ones, nowhere (it stays put), or out of sight.
enum TickedTasks {
  bottom
  stay
  hide
}

// What a message from the suggestion box is about.
enum FeedbackKind {
  bug
  feature
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  passwordHash    String
  createdAt       DateTime @default(now())
  // How the dashboard's tiles are arranged and which are pinned; null = the default single column.
  dashboardLayout Json?
  // The same for the stats boxes on the user's page.
  statsLayout     Json?
  // What a task written straight into Today (so in no list) is worth, unless it has its own amount.
  todayPoints     Int      @default(2)
  // What the lists do with a ticked task.
  tickedTasks     TickedTasks @default(bottom)
  // The most points the balance can hold: earning past it is refused. null = no cap.
  pointsCap       Int?
  // A reminder to take a break after every so many tasks done in a day; null = no reminder.
  breakEvery      Int?
  // Whether the tutorial was finished or skipped; it shows until then, and again when asked for in the settings.
  tutorialSeen    Boolean  @default(false)
  // Theme: the text inside the boxes in an ordinary font instead of the pixel one; titles keep the pixel font.
  plainFont       Boolean  @default(false)

  goals             Goal[]
  tags              Tag[]
  tasks             Task[]
  lists             List[]
  folders           Folder[]
  pointTransactions PointTransaction[]
  taskCompletions   TaskCompletion[]
  feedback          Feedback[]
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

// A free-form label. Works like a goal (many per task, filterable) without
// meaning "something I'm working towards".
model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Task {
  id           String        @id @default(uuid())
  userId       String
  parentId     String?
  // The list (folder) a top-level task sits in. Null for subtasks, which
  // belong to their parent's list.
  listId       String?
  title        String
  notes        String?
  startDate    String?
  deadlineDate String?
  deadlineType DeadlineType?
  isComplete   Boolean       @default(false)
  // Stamp-once: set on completion, cleared on un-toggle.
  completedAt  DateTime?
  completedOn  String?
  // A number is a hand-set amount that travels with the task. Null on a top-level task = worth the
  // list's defaultPoints; null on a subtask = worth nothing, or what its main task is worth if that
  // one has pointsToSubtasks. The list's kind decides add or subtract.
  points       Int?
  // Top-level tasks only: subtasks without an amount of their own are worth what this task is.
  pointsToSubtasks Boolean   @default(false)
  // The day the task was marked for Today; null = not in Today.
  todaySince   String?
  // Top-level tasks only. Done again and again: never complete, each press is a TaskCompletion.
  isPersistent Boolean       @default(false)
  // A persistent task on a schedule: due again every repeatEvery units. Null = no schedule, done whenever.
  repeatEvery     Int?
  repeatUnit      RepeatUnit    @default(week)
  // false: the next round keeps to the planned days. true: it is counted from the day the task was done.
  repeatAfterDone Boolean       @default(false)
  // The day the next round is due; set while repeatEvery is.
  nextDue         String?
  // Soft delete, so a delete can be undone. Set on the whole deleted subtree
  // with one shared timestamp; every query must filter on deletedAt = null.
  deletedAt    DateTime?
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent            Task?              @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Task[]             @relation("TaskTree")
  // Any task can carry several goals and several tags.
  goals             Goal[]
  tags              Tag[]
  list              List?              @relation(fields: [listId], references: [id], onDelete: Cascade)
  completions       TaskCompletion[]
  pointTransactions PointTransaction[]

  @@index([userId])
  @@index([parentId])
  @@index([listId])
}

model List {
  id            String    @id @default(uuid())
  userId        String
  name          String
  description   String?
  position      Int       @default(0)
  kind          ListKind  @default(task)
  // The colour of the list's box, "#rrggbb", picked by the user. Null = the kind's own: blue for tasks, orange for rewards.
  color         String?
  // What a top-level task in this list is worth unless it has its own amount.
  defaultPoints Int       @default(1)
  isArchived    Boolean   @default(false)
  // Soft delete, undoable like tasks. The list's tasks get the same timestamp.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

// A tab of the user's own in the task bar: a page of views. Removing it removes nothing else.
model Folder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  // The colour of its icon, "#rrggbb"; null = the icon as drawn.
  color     String?
  position  Int      @default(0)
  // How the folder's page arranges its boxes; the same shape as User.dashboardLayout.
  layout    Json?
  // The boxes it shows, by key: "list:<id>" (a list, which stays on the Tasks page too) or "stat:<name>"
  // (a box of the stats). A key whose list is gone shows nothing.
  views     Json     @default("[]")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Append-only ledger. Balance = SUM(amount).
model PointTransaction {
  id            String               @id @default(uuid())
  userId        String
  type          PointTransactionType
  amount        Int
  relatedTaskId String?
  // The task's title when the row was written, so history still reads after the task is gone.
  title         String               @default("")
  // On a reversal: the earned / redeemed row it cancels.
  reversesId    String?              @unique
  createdAt     DateTime             @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task?             @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  reverses   PointTransaction? @relation("Reversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy PointTransaction? @relation("Reversal")

  @@index([userId])
  @@index([relatedTaskId])
}

// One press of a persistent task's "done it" button.
model TaskCompletion {
  id                 String   @id @default(uuid())
  userId             String
  taskId             String
  day                String
  // The points this press booked, if any; reversed when the press is undone.
  pointTransactionId String?
  // Subtasks the press unticked for the next round, with their stamps, so undo can put them back.
  unticked           Json     @default("[]")
  // What the task's nextDue was before this press moved it on, so undo can put it back.
  dueBefore          String?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// A message from the suggestion box on the user's page. Shown only in the inbox on a developer's page.
model Feedback {
  id        String       @id @default(uuid())
  userId    String
  kind      FeedbackKind
  subject   String
  message   String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Session store for connect-pg-simple. Declared here so Prisma migrations own
// the table and don't report it as drift.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
