DATABASE_URL="postgresql://donegeon:donegeon@localhost:5432/donegeon?schema=public"
SESSION_SECRET="change-me"
PORT=3001
# Usernames of the developers, who read the mail sent from the user page (comma-separated).
DEV_USERNAMES=reo
# Push notifications: the server's VAPID keys, from `npx web-push generate-vapid-keys`. Without them nothing is pushed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push services may write to about this server's pushes.
VAPID_SUBJECT=mailto:you@example.com
# Optional: what a call to POST /api/notifications/tick sends in X-Tick-Secret, to wake a sleeping server to send.
# Not needed while a health check keeps the server awake (it sends every minute then). Unset: no such call.
PUSH_TICK_SECRET=
